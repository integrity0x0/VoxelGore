<page id="controls" input-mode="passthrough" script="ui/control_android.xml.lua">
	<styles>
		<style name="panel" color="#01020474" border="1" border-color="#6291A928"/>
		<style name="btn" extends="panel" pivot="center">
			<state name="hover" border-color="#8BB4C850"/>
			<state name="held" scale="0.925"/>
		</style>
		<style name="ctrlBtn" extends="btn" size="112" radius="26"/>
	</styles>

	<container id="leftPad" anchor="left, bottom" pos="36, -36" size="352" visible="false">
		<button id="btnBreak" style="ctrlBtn" pos="56, 56"
			on-click="onBreakPress" on-release="onBreakRelease"/>
		<button id="btnForward" style="ctrlBtn" pos="176, 56"
			on-click="onMoveForwardHeld" on-release="onMoveForwardRelease"/>
		<button id="btnPlace" style="ctrlBtn" pos="296, 56"
			on-click="onInteractPress" on-release="onInteractRelease"/>
		<button id="btnLeft" style="ctrlBtn" pos="56, 176"
			on-click="onMoveLeftHeld" on-release="onMoveLeftRelease"/>
		<button id="btnRight" style="ctrlBtn" pos="296, 176"
			on-click="onMoveRightHeld" on-release="onMoveRightRelease"/>
		<button id="btnBack" style="ctrlBtn" pos="176, 296"
			on-click="onMoveBackHeld" on-release="onMoveBackRelease"/>
	</container>

	<container id="actions" anchor="right, bottom" pos="-36, -36" size="240" visible="false">
		<button id="btnJump" style="ctrlBtn" pos="120, 120" size="144" radius="34"
			on-click="onJumpPress" on-release="onJumpRelease"/>
	</container>
</page>