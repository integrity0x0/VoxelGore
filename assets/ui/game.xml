<page id="hud" input-mode="passthrough" script="ui/game.xml.lua">

	<container id="topLeft" pos="14, 12" size="209, 47" color="#00000000">
		<button id="btnSettings" pos="0, 0" size="47" radius="11"
			color="#01020474" border="1" border-color="#6291A928">
			<image anchor="center" size="22" src="images/settings_gear.png"/>
		</button>

		<button id="btnChat" pos="54, 0" size="47" radius="11"
			color="#01020474" border="1" border-color="#6291A928">
			<image anchor="center" size="22" src="images/chat.png"/>
		</button>

		<button id="btnFriends" pos="108, 0" size="47" radius="11"
			color="#01020474" border="1" border-color="#6291A928">
			<image anchor="center" size="22" src="images/friends.png"/>
		</button>

		<button id="btnRating" pos="162, 0" size="47" radius="11"
			color="#01020474" border="1" border-color="#6291A928">
			<image anchor="center" size="22" src="images/star.png"/>
		</button>
	</container>

	<container id="currency" anchor="right, top" pos="-14, 13" size="229, 40" color="#00000000">
		<container id="money" pos="0, 0" size="85, 40" radius="9"
			color="#01020474" border="1" border-color="#6291A928">
			<container anchor="left, center" pos="11, 0" size="19" radius="9.5"
				color="#BC9D3613" border="1" border-color="#BC9D3630"/>
		</container>

		<container id="gems" pos="93, 0" size="85, 40" radius="9"
			color="#01020474" border="1" border-color="#6291A928">
			<container anchor="left, center" pos="11, 0" size="19" radius="9.5"
				color="#3D8DB112" border="1" border-color="#4999B630"/>
		</container>

		<button id="shop" pos="186, 0" size="43, 40" radius="9"
			color="#01020474" border="1" border-color="#6291A928">
			<image anchor="center" size="22" src="images/shop.png"/>
		</button>
	</container>

	<container id="minimap" anchor="right, top" pos="-18, 82" size="132" radius="66"
		color="#01020474" border="1" border-color="#6291A928">

		<container anchor="center" size="104" radius="52"
			color="#6291A909" border="1" border-color="#6291A914"/>

		<container id="mapGrid" anchor="center" size="104" radius="52" color="#00000000">
			<container anchor="center" size="104, 1" color="#6291A917"/>
			<container anchor="center" size="1, 104" color="#6291A917"/>
			<container pos="30%, 31%" size="5" radius="2.5" color="#87A9B82D"/>
			<container pos="68%, 38%" size="5" radius="2.5" color="#87A9B82D"/>
			<container pos="61%, 71%" size="5" radius="2.5" color="#87A9B82D"/>
		</container>

		<container id="playerMarker" anchor="center" size="9" radius="4.5" color="#55D67C"/>
	</container>

	<container id="bottom" anchor="center, bottom" pos="0, -18" size="420, 109" color="#00000000">

		<container id="stats" pos="0, 0" size="420, 44" color="#00000000">

			<container id="hp" pos="0, 0" size="200, 19" color="#00000000">
				<image pos="0, 0" size="19" src="images/heart.png"/>

				<container id="hpBar" pos="24, 3" size="176, 13"
					radius="3" padding="1"
					bg-color="#05070B" color="#05070B"
					border="1" border-color="#35404F">
					<container id="hpFill" size="100%, 100%" radius="2" color="#FF1738"/>
				</container>
			</container>

			<container id="armor" pos="220, 0" size="200, 19" color="#00000000">
				<image pos="0, 0" size="19" src="images/armor.png"/>

				<container id="armorBar" pos="24, 3" size="176, 13"
					radius="3" padding="1"
					bg-color="#05070B" color="#05070B"
					border="1" border-color="#35404F">
					<container id="armorFill" size="0%, 100%" radius="2" color="#168BFF"/>
				</container>
			</container>

			<container id="thirst" pos="0, 24" size="200, 19" color="#00000000">
				<image pos="0, 0" size="19" src="images/thirst.png"/>

				<container id="thirstBar" pos="24, 3" size="176, 13"
					radius="3" padding="1"
					bg-color="#05070B" color="#05070B"
					border="1" border-color="#35404F">
					<container id="thirstFill" size="100%, 100%" radius="2" color="#00D9FF"/>
				</container>
			</container>

		</container>

		<container id="hotbar" anchor="center, top" pos="0, 51" size="420, 58" radius="9"
			color="#01020474" border="1" border-color="#6291A928">

			<button id="slot0" pos="5, 5" size="48" radius="8"
				color="#080D146D" border="1" border-color="#F0D04B"/>
			<button id="slot1" pos="57, 5" size="48" radius="8"
				color="#01020464" border="1" border-color="#6291A928"/>
			<button id="slot2" pos="109, 5" size="48" radius="8"
				color="#01020464" border="1" border-color="#6291A928"/>
			<button id="slot3" pos="161, 5" size="48" radius="8"
				color="#01020464" border="1" border-color="#6291A928"/>
			<button id="slot4" pos="213, 5" size="48" radius="8"
				color="#01020464" border="1" border-color="#6291A928"/>
			<button id="slot5" pos="265, 5" size="48" radius="8"
				color="#01020464" border="1" border-color="#6291A928"/>
			<button id="slot6" pos="317, 5" size="48" radius="8"
				color="#01020464" border="1" border-color="#6291A928"/>
			<button id="more" pos="369, 5" size="46" radius="8"
				color="#01020464" border="1" border-color="#6291A928"/>
		</container>

	</container>

</page>