<page input-mode="capture" script="pages/msgbox.xml.lua">
	<styles>
		<style name="panel" color="#01020474" border="1" border-color="#6291A928"/>
		<style name="btn" extends="panel" pivot="center">
			<state name="hover" border-color="#8BB4C850"/>
			<state name="held" scale="0.925"/>
		</style>
		<style name="msgPanel" extends="panel" radius="18"/>
		<style name="okBtn" extends="btn" size="240, 63" radius="15" color="#2E6F4A66" border-color="#4CAF7850">
			<state name="hover" color="#2E6F4A90" border-color="#4CAF7880"/>
		</style>
		<style name="titleText"
			anchor="center, top" pos="0, 33"
			color="#FFFFFF" font="rubik" font-size="30"
			text-shadow="true" shadow-offset="2" shadow-color="#000000B0"/>
		<style name="msgText"
			anchor="center, top" pos="0, 93"
			color="#E8F0F8" font="rubik" font-size="27"
			text-shadow="true" shadow-offset="2" shadow-color="#000000A0"/>
	</styles>
	<container id="overlay" size="100%" color="#000000B0"/>
	<container id="box" style="msgPanel" anchor="center" size="570, 420">
		<text id="title" style="titleText" text="Добро пожаловать в v0.11-alpha" interactive="false"/>
		<text id="message" style="msgText" size="510, auto" interactive="false"
			text="— Переработан интерфейс\n— Добавлено здоровье игрока\n— Добавлен инвентарь\n— Добавлен текст\n— Исправлена тряска камеры\n— Добавлена инерция камеры\n— Исправлен рендер стекла\n— Мелкие правки в кодовой базе"/>
		<button id="btnOk" style="okBtn" anchor="center, bottom" pos="0, 27"
			on-release="OnOkRelease">
			<text anchor="center" font="rubik" font-size="24" color="#FFFFFF"
				text-shadow="true" shadow-offset="2" shadow-color="#000000C0"
				text="ОК" interactive="false"/>
		</button>
	</container>
</page>